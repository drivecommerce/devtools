{
    "name": "drive-devtools",
    "displayName": "Drive DevTools",
    "version": "1.1.2",
    "packageManager": "pnpm@8.3.1",
    "description": "A devtools extension to support Drive Commerce development and customer care.",
    "scripts": {
        "dev": "npm run clear && cross-env NODE_ENV=development run-p dev:*",
        "serve": "npm run dev",
        "dev-firefox": "npm run clear && cross-env NODE_ENV=development EXTENSION=firefox run-p dev:*",
        "dev:prepare": "esno scripts/prepare.ts",
        "dev:web": "vite",
        "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare",
        "build:prepare": "esno scripts/prepare.ts",
        "build:web": "vite build",
        "pack": "cross-env NODE_ENV=production run-p pack:*",
        "pack:zip": "rimraf extension.zip && jszip-cli add extension/* -o ./extension.zip",
        "pack:crx": "crx pack extension -o ./extension.crx",
        "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir ./extension --filename extension.xpi --overwrite-dest",
        "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
        "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
        "clear": "rimraf --glob extension/dist extension/manifest.json extension.*",
        "lint": "eslint --cache .",
        "test": "vitest test",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^0.36.0",
        "@ffflorian/jszip-cli": "^3.4.1",
        "@iconify/json": "^2.2.61",
        "@playwright/test": "^1.33.0",
        "@stylistic/eslint-plugin-ts": "^2.12.1",
        "@tailwindcss/forms": "^0.5.7",
        "@types/fs-extra": "^11.0.1",
        "@types/node": "^18.16.5",
        "@types/webextension-polyfill": "^0.10.0",
        "@typescript-eslint/eslint-plugin": "^8.19.0",
        "@typescript-eslint/parser": "^8.19.0",
        "@unocss/preset-wind": "^0.57.3",
        "@unocss/reset": "^0.51.12",
        "@vitejs/plugin-vue": "^4.2.1",
        "@vue/compiler-sfc": "^3.2.47",
        "@vue/test-utils": "^2.3.2",
        "@vueuse/core": "^10.1.2",
        "autoprefixer": "^10.4.16",
        "chokidar": "^3.5.3",
        "cross-env": "^7.0.3",
        "crx": "^5.0.1",
        "eslint": "^9.17.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-readable-tailwind": "^1.8.2",
        "eslint-plugin-tailwindcss": "^3.17.5",
        "eslint-plugin-vue": "^9.32.0",
        "esno": "^0.16.3",
        "fs-extra": "^11.1.1",
        "globals": "^15.14.0",
        "jsdom": "^21.1.2",
        "kolorist": "^1.8.0",
        "lint-staged": "^13.2.2",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.31",
        "rimraf": "^4.4.1",
        "simple-git-hooks": "^2.8.1",
        "tailwindcss": "^3.3.5",
        "typescript": "^4.9.5",
        "typescript-eslint": "^8.19.0",
        "unocss": "^0.51.12",
        "unplugin-auto-import": "^0.15.3",
        "unplugin-icons": "^0.16.1",
        "unplugin-vue-components": "^0.24.1",
        "vite": "^4.3.5",
        "vitest": "^0.31.0",
        "vue": "^3.2.47",
        "vue-demi": "^0.14.0",
        "web-ext": "^7.6.2",
        "webext-bridge": "^6.0.1",
        "webextension-polyfill": "^0.10.0"
    },
    "dependencies": {
        "@alenaksu/json-viewer": "^2.0.1",
        "@types/chrome": "^0.0.251",
        "geotiff": "^2.1.3",
        "object-visualizer": "^5.0.0",
        "preline": "^2.0.2",
        "tiff": "^6.1.1",
        "utif": "^3.1.0"
    }
}
